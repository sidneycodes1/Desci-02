    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.29.6",
    "eslint-plugin-jsx-a11y": "^6.8.1",
    "eslint-plugin-react": "^7.34.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^14.0.0",
