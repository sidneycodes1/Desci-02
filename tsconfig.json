{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@sciagent/shared": ["packages/shared/src/index.ts"],
      "@sciagent/shared/*": ["packages/shared/*"],
      "@sciagent/ui": ["packages/ui/src/index.ts"],
      "@sciagent/ui/*": ["packages/ui/src/*"],
      "@sciagent/database": ["packages/database/src/index.ts"],
      "@sciagent/database/*": ["packages/database/src/*"],
      "@sciagent/contracts": ["packages/contracts/src/index.ts"],
      "@sciagent/contracts/*": ["packages/contracts/src/*"],
      "@sciagent/agents": ["packages/agents/src/index.ts"],
      "@sciagent/agents/*": ["packages/agents/*"],
      "@sciagent/auth": ["packages/auth/src/index.ts"],
      "@sciagent/auth/*": ["packages/auth/src/*"]
    }
  },
  "include": ["packages", "apps", "next-env.d.ts"],
  "references": []
}
