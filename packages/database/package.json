{
  "name": "@sciagent/database",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx src/seed.ts"
  },
  "devDependencies": {
    "@sciagent/typescript-config": "workspace:*",
    "drizzle-kit": "0.31.4",
    "tsx": "4.19.2",
    "typescript": "5.5.4",
    "vitest": "2.1.9"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.9",
    "drizzle-orm": "0.44.4"
  }
}
